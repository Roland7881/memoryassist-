{
  "name": "memoryassist-overlay",
  "version": "1.0.0",
  "description": "Always-on-top overlay for Memory Assist",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.memoryassist.overlay",
    "productName": "MemoryAssist Overlay",
    "files": [
      "main.js",
      "overlay.html",
      "*.png",
      "icon.ico"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^25.1.8"
  }
}
